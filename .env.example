# Supabase (obligatorias en local y producción)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# URL pública de la app (enlaces de invitación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP — opcional en local, obligatorio en producción
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=crm@tu-dominio.com
EMAIL_FROM_NAME=Patel CRM
NOTIFY_VISOR_EMAIL=visor@tu-dominio.com

# Cron de vencidas (producción)
CRON_SECRET=cambia-esto-por-un-secreto-largo

# Dominio del VPS (Caddy / Let's Encrypt)
DOMAIN=crm.tu-dominio.com
ACME_EMAIL=admin@tu-dominio.com

# Sentry (producción)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
